---
// 有封面圖就顯示圖片，沒有就用代表色＋作品名稱當封面
interface Props { title: string; cover?: string; color: string; size?: 'sm' | 'lg' }
const { title, cover, color, size = 'sm' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = cover ? (cover.startsWith('http') ? cover : base + cover.replace(/^\//, '')) : undefined;
const label = title.split(/[：:]/)[0];
---
{src
  ? <img class={`cover ${size}`} src={src} alt={title} loading="lazy" />
  : <div class={`cover ${size} fallback`} style={`--c:${color}`}><span>{label}</span></div>}

<style>
  .cover { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; }
  .cover.lg { aspect-ratio: 16 / 8; border-radius: var(--radius); }
  img.cover { object-position: left top; border: 1px solid var(--line); }
  img.cover.lg { aspect-ratio: auto; height: auto; }
  .fallback {
    display: flex; align-items: flex-end; padding: 12px 14px;
    background:
      radial-gradient(circle at 85% 15%, color-mix(in srgb, var(--c) 45%, transparent) 0 22%, transparent 23%),
      color-mix(in srgb, var(--c) 14%, var(--card));
    border: 1px solid color-mix(in srgb, var(--c) 22%, var(--line));
    color: color-mix(in srgb, var(--c) 75%, var(--ink));
  }
  .fallback span { font-weight: 700; font-size: 15px; line-height: 1.3; }
  .lg.fallback { padding: 24px 28px; aspect-ratio: 16 / 5; }
  .lg.fallback span { font-size: 30px; }
</style>
