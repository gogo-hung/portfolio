---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const categories = ['全部', ...new Set(projects.map((p) => p.data.category))];
---
<Base>
  <section class="wrap hero">
    <p class="hi">Hi，我是</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.title}</p>
    <p class="intro">{profile.intro}</p>
    <div class="meta">
      <div>
        <span class="label">常用技術</span>
        <div class="chips">{profile.skills.map((s) => <span class="tag">{s}</span>)}</div>
      </div>
      <div>
        <span class="label">證照</span>
        <div class="chips">{profile.certs.map((c) => <span class="tag">{c}</span>)}</div>
      </div>
    </div>
    <div class="actions">
      <a class="btn primary" href="#projects">看作品</a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      {profile.links.email && <a class="btn" href={`mailto:${profile.links.email}`}>寄信給我</a>}
    </div>
  </section>

  <section id="projects" class="wrap list-section">
    <div class="list-head">
      <h2>我的作品 <span class="count">{projects.length}</span></h2>
      <div class="filters" role="tablist">
        {categories.map((c, i) => (
          <button class={`filter ${i === 0 ? 'active' : ''}`} data-cat={c}>{c}</button>
        ))}
      </div>
    </div>

    <ul class="posts">
      {projects.map((p) => (
        <li data-cat={p.data.category}>
          <a class="post" href={`${base}projects/${p.id}/`}>
            <div class="thumb"><Cover title={p.data.title} cover={p.data.cover} color={p.data.color} /></div>
            <div class="body">
              <div class="top">
                {p.data.featured && <span class="feat">精選</span>}
                <span class={`status s-${p.data.status}`}>{p.data.status}</span>
                <span class="cat">{p.data.category}</span>
              </div>
              <h3>{p.data.title}</h3>
              <p class="summary">{p.data.summary}</p>
              <p class="tech">{p.data.tech.slice(0, 4).join(' · ')}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLLIElement>('.posts li');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      const cat = btn.dataset.cat;
      items.forEach((li) => (li.hidden = cat !== '全部' && li.dataset.cat !== cat));
    })
  );
</script>

<style>
  .hero { padding-top: 72px; padding-bottom: 56px; }
  .hi { margin: 0; color: var(--muted); font-size: 16px; }
  h1 { margin: 2px 0 2px; font-size: clamp(34px, 6vw, 48px); line-height: 1.15; letter-spacing: .02em; }
  .role { margin: 0 0 18px; color: var(--accent); font-weight: 500; font-size: 17px; }
  .intro { margin: 0 0 26px; font-size: 17px; max-width: 620px; color: var(--ink); }
  .meta { display: grid; gap: 14px; margin-bottom: 30px; }
  .label { display: block; font-size: 13px; color: var(--faint); margin-bottom: 6px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .list-section { border-top: 1px solid var(--line); padding-top: 44px; scroll-margin-top: 60px; }
  .list-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 18px; }
  h2 { margin: 0; font-size: 24px; }
  .count { font-size: 15px; color: var(--faint); font-weight: 400; margin-left: 4px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter { font: inherit; font-size: 13.5px; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--muted); cursor: pointer; }
  .filter:hover { color: var(--ink); }
  .filter.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { border-bottom: 1px solid var(--line); }
  .posts li[hidden] { display: none; }
  .post { display: grid; grid-template-columns: 210px 1fr; gap: 24px; padding: 22px 0; text-decoration: none; align-items: center; }
  .post:hover h3 { color: var(--accent); }
  .post:hover .thumb { transform: translateY(-2px); }
  .thumb { transition: transform .2s; }
  .top { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; font-size: 13px; }
  .feat { font-size: 12px; font-weight: 500; padding: 2px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .cat { color: var(--faint); }
  h3 { margin: 0 0 4px; font-size: 19px; line-height: 1.4; transition: color .15s; }
  .summary { margin: 0 0 6px; color: var(--muted); font-size: 15px; }
  .tech { margin: 0; color: var(--faint); font-size: 13px; }
  @media (max-width: 600px) {
    .hero { padding-top: 48px; }
    .post { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
