---
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; image?: string }
const { title, description = profile.intro, image = '/og.png' } = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageTitle = title ? `${title}｜${profile.name}` : `${profile.name}｜作品集`;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.name}｜作品集`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.png' && <meta property="og:image:width" content="1200" />}
    {image === '/og.png' && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="zh_TW" />
    <link rel="image_src" href={ogImage} />
    <meta itemprop="image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <img src={ogImage} alt="" width="1200" height="630" loading="lazy" style="display:none" aria-hidden="true" />
    <header class="nav">
      <div class="wrap nav-inner">
        <a href={base} class="logo">{profile.name}</a>
        <nav>
          <a href={`${base}#projects`}>作品</a>
          <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="wrap footer">© {new Date().getFullYear()} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf7;
    --card: #ffffff;
    --ink: #1c1d21;
    --muted: #63656e;
    --faint: #9a9ca5;
    --line: #e6e5df;
    --accent: #2f5bea;
    --accent-soft: #eaf0fe;
    --radius: 14px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141518; --card: #1c1d21; --ink: #ececef; --muted: #a3a5ad;
      --faint: #74767e; --line: #2c2d33; --accent: #7d9bff; --accent-soft: #1f2640;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: 'Noto Sans TC', system-ui, -apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    line-height: 1.75; -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 880px; margin: 0 auto; padding: 0 22px; }
  .nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; justify-content: space-between; align-items: center; height: 58px; }
  .logo { font-weight: 700; text-decoration: none; letter-spacing: .04em; }
  .nav nav { display: flex; gap: 22px; font-size: 15px; }
  .nav nav a { text-decoration: none; color: var(--muted); }
  .nav nav a:hover { color: var(--ink); }
  .footer { color: var(--faint); font-size: 13px; padding-top: 48px; padding-bottom: 40px; }
  .tag { display: inline-block; font-size: 12.5px; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: var(--card); }
  .btn { display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; padding: 8px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); text-decoration: none; font-weight: 500; transition: border-color .15s; }
  .btn:hover { border-color: var(--faint); }
  .btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .status { font-size: 12px; font-weight: 500; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
  .status.s-上線中 { background: #e3f5ea; color: #1d6b3c; }
  .status.s-開發中 { background: #fff2d9; color: #8a5a00; }
  .status.s-規劃中 { background: #eceef3; color: #545866; }
  @media (prefers-color-scheme: dark) {
    .status.s-上線中 { background: #193526; color: #8fdcac; }
    .status.s-開發中 { background: #3a2c0d; color: #f2c46b; }
    .status.s-規劃中 { background: #2a2c33; color: #b4b7c2; }
  }
</style>
